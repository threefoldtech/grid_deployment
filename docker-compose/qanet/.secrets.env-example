#########################################
#     Unique Grid backend variables     #
#########################################
### Custom variables - this seciton must be provided by the entity running this backend stack. See documentation.

# Enter the (sub)domain name that will be used to host this backend.
# Example: DOMAIN=grid.tf
DOMAIN=

# Backup domain: a grid dashboard can be configured with multiple service endpoints, this to provide some form of HA. 
# Note: please take care not to configure your dashboard with the same two domains!
# Note: filled in example will work but can be changed, 02.qa.grid.tf is a Grid backend stack ran by Threefold. 
BCKP_DOMAIN=02.qa.grid.tf

# Enter the TFchain node node-key
# NOTE: make sure this is an unique node-key for each instance !
TFCHAIN_NODE_KEY=

# Enter Activation service Mnemonic (add in between "")
# NOTE: make sure this service has an unique tfchain wallet on devnet funded with at least 10TFT !
ACTIVATION_SERVICE_MNEMONIC=""

# Enter the Gridproxy Mnemonic (add in between "")
# NOTE: make sure this service has an unique tfchain wallet on devnet funded with at least 10TFT and a registered Twin ID on the chain !
GRID_PROXY_MNEMONIC=""
